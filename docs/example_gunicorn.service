# Exempel på systemd-tjänst för Gunicorn
# Spara som /etc/systemd/system/gunicorn.service

[Unit]
Description=gunicorn daemon for MinaRecept
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/ReceptApp
ExecStart=/home/ubuntu/ReceptApp/venv/bin/gunicorn \
  --access-logfile - \
  --workers 3 \
  --bind 127.0.0.1:8000 \
  receptapp_project.wsgi:application

[Install]
WantedBy=multi-user.target
